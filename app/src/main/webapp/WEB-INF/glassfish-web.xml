<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE glassfish-web-app PUBLIC "-//GlassFish.org//DTD GlassFish Application Server 3.1 Servlet 3.0//EN"
        "http://glassfish.org/dtds/glassfish-web-app_3_0-1.dtd">
<!-- Payara writes the SameSite attribute of the session cookie only from this setting (ADR-0020). -->
<glassfish-web-app>
    <session-config>
        <cookie-properties>
            <property name="cookieSameSite" value="Lax"/>
        </cookie-properties>
    </session-config>
</glassfish-web-app>
