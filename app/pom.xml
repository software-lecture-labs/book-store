<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bookstore</groupId>
        <artifactId>bookstore-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>app</artifactId>
    <packaging>war</packaging>
    <name>Book Store :: App</name>
    <description>Entry point that puts the business modules together. Becomes a WAR on Payara Micro in phase 6 (ADR-0010).</description>

    <dependencies>
        <dependency>
            <groupId>com.bookstore</groupId>
            <artifactId>shared-web</artifactId>
        </dependency>
        <!-- The server provides the Jakarta EE 11 Web Profile and MicroProfile (ADR-0010). -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-web-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>at.favre.lib</groupId>
            <artifactId>bcrypt</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.openapi</groupId>
            <artifactId>microprofile-openapi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.health</groupId>
            <artifactId>microprofile-health-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.weld.se</groupId>
            <artifactId>weld-se-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.bookstore</groupId>
            <artifactId>shared-web</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.bookstore</groupId>
            <artifactId>catalog</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bookstore</groupId>
            <artifactId>customer</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bookstore</groupId>
            <artifactId>sales</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bookstore</groupId>
            <artifactId>review</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bookstore</groupId>
            <artifactId>shared-jdbc</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bookstore</groupId>
            <artifactId>shared-kernel</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.bookstore</groupId>
            <artifactId>catalog</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.bookstore</groupId>
            <artifactId>customer</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.bookstore</groupId>
            <artifactId>sales</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The JAX-RS stack the rest tests run on, without an application server (ADR-0010). -->
        <dependency>
            <groupId>org.glassfish.jersey.containers</groupId>
            <artifactId>jersey-container-jdk-http</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.inject</groupId>
            <artifactId>jersey-hk2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.media</groupId>
            <artifactId>jersey-media-json-binding</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.ext</groupId>
            <artifactId>jersey-bean-validation</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- bookstore.war for Payara Micro (ADR-0010); the classes also go into a jar for the architecture tests. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>${war-plugin.version}</version>
                <configuration>
                    <warName>bookstore</warName>
                    <attachClasses>true</attachClasses>
                    <!-- Payara provides Bean Validation; a second copy in the WAR would clash with it. -->
                    <packagingExcludes>WEB-INF/lib/hibernate-validator-*.jar,WEB-INF/lib/jakarta.validation-api-*.jar,WEB-INF/lib/classmate-*.jar,WEB-INF/lib/jboss-logging-*.jar</packagingExcludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          ./mvnw -pl app -Ppayara package exec:exec   (after ./mvnw install -DskipTests)
          copies Payara Micro next to the WAR and starts it on http://localhost:8080 with the WAR at /.
          Maven passes the arguments straight to Java, so no shell rewrites "/" into a path.
        -->
        <profile>
            <id>payara</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>${dependency-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>copy-payara-micro</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy</goal>
                                </goals>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>fish.payara.extras</groupId>
                                            <artifactId>payara-micro</artifactId>
                                            <version>${payara-micro.version}</version>
                                            <destFileName>payara-micro.jar</destFileName>
                                        </artifactItem>
                                    </artifactItems>
                                    <outputDirectory>${project.build.directory}</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${exec-plugin.version}</version>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <!-- Payara upper-cases its cookie settings with the default locale and cannot start
                                     on a Turkish one ("dynamic" becomes "DYNAMİC"); see ADR-0020. -->
                                <argument>-Duser.language=en</argument>
                                <argument>-Duser.country=US</argument>
                                <argument>-jar</argument>
                                <argument>${project.build.directory}/payara-micro.jar</argument>
                                <argument>--deploy</argument>
                                <argument>${project.build.directory}/bookstore.war</argument>
                                <argument>--contextRoot</argument>
                                <argument>/</argument>
                                <argument>--port</argument>
                                <argument>8080</argument>
                                <argument>--nocluster</argument>
                            </arguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
